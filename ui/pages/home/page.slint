import { HeadingLg, Icon, IconButton, OverlayMenu, PopupMenuItem,
         ScrollBody, TextLg, TextMd, TextSm, BasePage } from "@ui/widgets.slint";
import { Importance, Size, IconSize } from "@ui/theme.slint";
import { Callbacks, WalletRow } from "../../callbacks.slint";
import { HomePageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Cake } from "../../cake-theme.slint";

component WalletCard inherits Rectangle {
    in property <WalletRow> wallet;
    callback clicked;

    height: 78px;
    background: Cake.surface;
    border-radius: Size.sz3;
    clip: true;

    HorizontalLayout {
        padding-left: Size.sz4;
        padding-right: Size.sz4;
        spacing: Size.sz3;

        VerticalLayout {
            width: Size.sz11;
            alignment: center;
            Rectangle {
                width: Size.sz11;
                height: Size.sz11;
                border-radius: Size.sz6;
                background: wallet.archived ? Cake.surface-alt : (wallet.derived ? Cake.blue : Cake.monero);
                Icon {
                    name: wallet.archived ? "archive" : (wallet.derived ? "device" : "import");
                    size: IconSize.px32;
                    color: wallet.archived ? Cake.on-surface-dim : (wallet.derived ? Cake.background : Cake.on-surface);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            TextLg {
                text: wallet.name;
                color: Cake.on-surface;
                bold: true;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Icon {
                name: "chevron-right";
                color: Cake.on-surface-dim;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    states [
        pressed when touch.pressed: {
            root.background: Cake.surface-alt;
        }
    ]
}

component CakeLogoMark inherits Rectangle {
    in property <length> mark-size: 118px;
    width: mark-size;
    height: mark-size;
    background: #00000000;

    Image {
        source: @image-url("../../../assets/icons/cake-logo.png");
        width: parent.width;
        height: parent.height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component HomePagePage inherits Rectangle {
    in property <HomePageProps> props;
    property <bool> is-menu-open: false;
    background: Cake.background;

    init => {
        Callbacks.select-first-active-wallet();
    }

    BasePage {
        background: Cake.background;

        VerticalLayout {
            Rectangle {
                height: Size.sz16;
                HeadingLg {
                    text: "Wallets";
                    color: Cake.on-surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
                IconButton {
                    icon: "ellipsis";
                    size: Size.sz10;
                    importance: Importance.normal;
                    x: parent.width - self.width - Size.sz6;
                    y: (parent.height - self.height) / 2;
                    clicked => { is-menu-open = !is-menu-open; }
                }
            }

            ScrollBody {
                p-x: Size.sz6;
                p-y: Size.sz4;

                VerticalLayout {
                    spacing: Size.sz4;

                    if Callbacks.wallet-count <= 1: HorizontalLayout {
                        alignment: center;
                        CakeLogoMark {
                            mark-size: 118px;
                        }
                    }

                    if Callbacks.wallet-count == 0: TextMd {
                        text: "Import or create a wallet.";
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if Callbacks.wallet-count == 1: TextMd {
                        text: "Open the wallet to sign transactions or pair with Cake.";
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if Callbacks.wallet-count == 2: HorizontalLayout {
                        alignment: center;
                        CakeLogoMark {
                            mark-size: 72px;
                        }
                    }

                    if Callbacks.status-text != "": TextSm {
                        text: Callbacks.status-text;
                        color: Cake.warning;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    for wallet in Callbacks.wallets: WalletCard {
                        wallet: wallet;
                        clicked => {
                            if Callbacks.select-wallet(wallet.id) {
                                Navigate.wallet-detail-page({ });
                            }
                        }
                    }

                    Rectangle { height: Size.sz4; }
                }
            }
        }

        if is-menu-open: OverlayMenu {
            width: parent.width;
            height: parent.height;
            touched-off => {
                is-menu-open = false;
            }
            PopupMenuItem {
                label: "Import wallet";
                icon: "import";
                first: true;
                clicked => {
                    is-menu-open = false;
                    Navigate.import-wallet-page({ });
                }
            }
            PopupMenuItem {
                label: "Create wallet";
                icon: "plus";
                clicked => {
                    is-menu-open = false;
                    Navigate.create-wallet-page({ });
                }
            }
            PopupMenuItem {
                label: "Archived wallets";
                icon: "archive";
                enabled: Callbacks.archived-wallet-count > 0;
                last: true;
                clicked => {
                    is-menu-open = false;
                    Navigate.wallet-manager-page({ });
                }
            }
        }
    }
}
