import { ButtonSection, HeadingLg, OverlayMenu,
         ScrollBody, TextMd, BasePage } from "../../compat/widgets.slint";
import { Importance, Size } from "../../compat/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { HomePageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Cake } from "../../cake-theme.slint";
import { CakeButton, CakeIconButton, CakeListTile,
         CakePopupMenuItem } from "../../cake-widgets.slint";

export component HomePagePage inherits Rectangle {
    in property <HomePageProps> props;
    property <bool> is-menu-open: false;
    background: Cake.background;

    init => {
        Callbacks.select-first-active-wallet();
    }

    BasePage {
        background: Cake.background;

        VerticalLayout {
            Rectangle {
                height: Size.sz16;
                HeadingLg {
                    text: "Wallets";
                    color: Cake.on-surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
                CakeIconButton {
                    icon: "ellipsis";
                    size: Size.sz10;
                    x: parent.width - self.width - Size.sz6;
                    y: (parent.height - self.height) / 2;
                    clicked => { is-menu-open = !is-menu-open; }
                }
            }

            ScrollBody {
                p-x: Size.sz6;
                p-y: Size.sz4;

                VerticalLayout {
                    spacing: Size.sz3;

                    if Callbacks.wallet-count == 0: TextMd {
                        text: "Restore or create a Monero wallet.";
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if Callbacks.wallet-count > 0: TextMd {
                        text: "Monero Wallets";
                        color: Cake.on-surface-strong;
                        bold: true;
                    }

                    for wallet in Callbacks.wallets: CakeListTile {
                        title: wallet.name;
                        subtitle: "";
                        icon: wallet.archived ? "archive" : (wallet.derived ? "device" : "import");
                        archived: wallet.archived;
                        show-monero-network: !wallet.archived;
                        cake-linked: wallet.cake-linked;
                        chip-color: wallet.archived ? Cake.surface-alt : (wallet.derived ? Cake.wallet-list-icon : Cake.monero);
                        icon-color: wallet.archived ? Cake.on-surface-dim : (wallet.derived ? Cake.blue-soft : Cake.on-monero);
                        clicked => {
                            if Callbacks.select-wallet(wallet.id) {
                                Navigate.wallet-detail-page({ });
                            }
                        }
                    }

                    Rectangle { height: Size.sz2; }
                }
            }

            ButtonSection {
                spacing: Size.sz3;
                padding-left: Size.sz6;
                padding-right: Size.sz6;
                padding-bottom: Size.sz4;

                CakeButton {
                    label: "Restore Wallet";
                    icon: "import";
                    importance: Importance.normal;
                    clicked => {
                        Navigate.import-wallet-page({ });
                    }
                }

                CakeButton {
                    label: "Create New Wallet";
                    icon: "plus";
                    importance: Importance.primary;
                    clicked => {
                        Navigate.create-wallet-page({ });
                    }
                }
            }
        }

        if is-menu-open: OverlayMenu {
            width: parent.width;
            height: parent.height;
            touched-off => {
                is-menu-open = false;
            }
            if Callbacks.ql-cake-paired: CakePopupMenuItem {
                label: "Forget Cake connection";
                icon: "bluetooth";
                first: true;
                height: Size.sz16 + Size.sz6;
                clicked => {
                    is-menu-open = false;
                    Callbacks.disconnect-quantum-link();
                }
            }
            CakePopupMenuItem {
                label: "Archived wallets";
                icon: "archive";
                first: !Callbacks.ql-cake-paired;
                enabled: Callbacks.archived-wallet-count > 0;
                last: true;
                clicked => {
                    is-menu-open = false;
                    Navigate.wallet-manager-page({ });
                }
            }
        }
    }
}
