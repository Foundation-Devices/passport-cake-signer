import { ButtonSection, ContentSection, NavHeader, Button, TextLg, TextSm, BasePage, PageBody } from "@ui/widgets.slint";
import { Palette, Size, Importance } from "@ui/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { SeedPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Cake } from "../../cake-theme.slint";

component SeedWordItem inherits Rectangle {
    in property <int> index;
    in property <string> word;

    height: 52px;
    width: 222px;
    background: Cake.surface;
    border-radius: Size.sz3;

    HorizontalLayout {
        padding-left: Size.sz3;
        padding-right: Size.sz3;
        spacing: Size.sz2;

        TextSm {
            text: "\{index + 1}.";
            width: Size.sz8;
            color: Cake.on-surface-dim;
            vertical-alignment: center;
        }

        TextLg {
            text: word;
            color: Cake.on-surface;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// 16-word Polyseed recovery phrase. Derived deterministically from the Passport
// app seed, so it is reproducible (re-deriving on this device gives the same
// words) and restores the wallet in Cake / any Polyseed wallet. Secret: only
// rendered after the user opts in from Home.
export component SeedPagePage inherits Rectangle {
    in property <SeedPageProps> props;
    background: Cake.background;

    BasePage {
        background: Cake.background;

        VerticalLayout {
            NavHeader {
                title: TR2.lookup(TrId.SeedTitle);
                left-icon: "chevron-left";
                clicked => {
                    Callbacks.clear-seed-words();
                    Navigate.home-page({ });
                }
            }
            PageBody {
                p-x: Size.sz2;
                p-y: Size.sz4;
                ContentSection {
                    spacing: Size.sz3;
                    TextSm {
                        text: TR2.lookup(TrId.SeedWarning);
                        color: Cake.warning;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: Size.sz2;

                        for row in 8: HorizontalLayout {
                            alignment: center;
                            spacing: Size.sz2;

                            for col in 2: SeedWordItem {
                                property <int> word-index: row + col * 8;
                                visible: word-index < Callbacks.seed-words.length;
                                index: word-index;
                                word: word-index < Callbacks.seed-words.length ? Callbacks.seed-words[word-index] : "";
                            }
                        }
                    }

                    TextSm {
                        text: TR2.lookup(TrId.SeedSubtitle);
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                ButtonSection {
                    Button {
                        label: TR2.lookup(TrId.Done);
                        importance: Importance.primary;
                        clicked => {
                            Callbacks.clear-seed-words();
                            Navigate.home-page({ });
                        }
                    }
                }
            }
        }
    }
}
