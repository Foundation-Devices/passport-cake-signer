import { ButtonSection, ContentSection, HeadingMd, Modal, Panel, Qrcode, TextLg, TextMd, TextSm, BasePage, PageBody } from "../../compat/widgets.slint";
import { CakeButton, CakeNavHeader, CakeQrFrame } from "../../cake-widgets.slint";
import { Palette, Size, Importance, UISize } from "../../compat/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { SeedPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Cake } from "../../cake-theme.slint";

component SeedWordItem inherits Rectangle {
    in property <int> index;
    in property <string> word;
    in property <bool> compact: false;

    height: compact ? 32px : 52px;
    width: 216px;
    background: Cake.wallet-list-card;
    border-radius: Cake.cta-radius;
    border-width: 1px;
    border-color: Cake.divider;
    clip: true;

    HorizontalLayout {
        padding-left: Size.sz3;
        padding-right: Size.sz3;
        spacing: Size.sz2;

        TextSm {
            text: "\{index + 1}.";
            width: Size.sz8;
            color: Cake.on-surface-dim;
            vertical-alignment: center;
        }

        if compact: TextMd {
            text: word;
            color: Cake.on-surface;
            overflow: elide;
            vertical-alignment: center;
        }

        if !compact: TextLg {
            text: word;
            color: Cake.on-surface;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// Wallet recovery phrase. Device-slot wallets are derived deterministically
// from the Passport app seed and slot number; imported wallets show the sealed
// phrase the user imported. Secret: only rendered after the user opts in from
// a wallet-specific menu.
export component SeedPagePage inherits Rectangle {
    in property <SeedPageProps> props;
    property <bool> is-seed-qr-open: false;
    property <bool> is-seed-warning-open: true;
    background: Cake.background;

    BasePage {
        background: Cake.background;

        VerticalLayout {
            CakeNavHeader {
                title: TR2.lookup(TrId.SeedTitle);
                left-icon: "chevron-left";
                right-icon: "scan-qr";
                clicked => {
                    Callbacks.clear-seed-words();
                    Navigate.wallet-detail-page({ });
                }
                right-clicked => { is-seed-qr-open = true; }
            }
            PageBody {
                p-x: Size.sz2;
                p-y: Size.sz3;

                Rectangle {
                    height: 548px;
                    clip: true;

                    Flickable {
                        width: parent.width;
                        height: parent.height;

                        ContentSection {
                            width: parent.width;
                            spacing: Size.sz2;

                            VerticalLayout {
                                alignment: center;
                                spacing: Size.sz1;

                                for row in 13: HorizontalLayout {
                                    alignment: center;
                                    spacing: Size.sz1;
                                    visible: row < (Callbacks.seed-words.length <= 16 ? 8 : 13);

                                    for col in 2: SeedWordItem {
                                        property <int> row-count: Callbacks.seed-words.length <= 16 ? 8 : 13;
                                        property <int> word-index: row + col * row-count;
                                        visible: word-index < Callbacks.seed-words.length;
                                        index: word-index;
                                        word: word-index < Callbacks.seed-words.length ? Callbacks.seed-words[word-index] : "";
                                        compact: Callbacks.seed-words.length > 16;
                                    }
                                }
                            }

                            TextSm {
                                text: TR2.lookup(TrId.SeedSubtitle);
                                color: Cake.on-surface-dim;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                ButtonSection {
                    CakeButton {
                        label: TR2.lookup(TrId.Done);
                        importance: Importance.primary;
                        clicked => {
                            Callbacks.clear-seed-words();
                            Navigate.wallet-detail-page({ });
                        }
                    }
                }
            }
        }

        if is-seed-warning-open: Modal {
            z: 300;
            width: parent.width;
            height: parent.height;
            icon: "alert";
            icon-color: Cake.warning;
            title: "Keep your recovery seed private";
            text: TR2.lookup(TrId.SeedWarning);

            CakeButton {
                label: "I understand";
                importance: Importance.primary;
                clicked => { is-seed-warning-open = false; }
            }
        }

        if is-seed-qr-open: Rectangle {
            z: 200;
            width: parent.width;
            height: parent.height;
            background: Palette.overlay;

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { is-seed-qr-open = false; }
            }

            Panel {
                width: UISize.modal-width;
                height: 560px;
                x: (parent.width - self.width) / 2;
                y: Size.sz12;
                background: Cake.surface;

                VerticalLayout {
                    padding: Size.sz5;
                    spacing: Size.sz4;

                    HeadingMd {
                        text: "Recovery phrase QR";
                        horizontal-alignment: center;
                    }

                    TextSm {
                        text: "Plain text seed for " + Callbacks.wallet-label;
                        color: Cake.warning;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: center;
                        CakeQrFrame {
                            width: 292px;
                            height: 292px;
                            Qrcode {
                                data: Callbacks.seed-qr-text;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }

                    CakeButton {
                        label: TR2.lookup(TrId.Done);
                        importance: Importance.primary;
                        clicked => { is-seed-qr-open = false; }
                    }
                }
            }
        }
    }
}
