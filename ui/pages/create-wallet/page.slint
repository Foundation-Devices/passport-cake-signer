import { ButtonSection, ContentSection, HeadingLg, Icon, NavHeader,
         PageBody, TextMd, BasePage } from "@ui/widgets.slint";
import { CakeButton, CakeStatusBanner } from "../../cake-widgets.slint";
import { Importance, Size, IconSize } from "@ui/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { CreateWalletPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Cake } from "../../cake-theme.slint";

export component CreateWalletPagePage inherits Rectangle {
    in property <CreateWalletPageProps> props;
    background: Cake.background;

    BasePage {
        background: Cake.background;

        VerticalLayout {
            NavHeader {
                title: "Create wallet";
                clicked => { Navigate.home-page({ }); }
            }

            PageBody {
                ContentSection {
                    spacing: Size.sz4;

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 88px;
                            height: 88px;
                            border-radius: Size.sz6;
                            background: Cake.surface;
                            Icon {
                                name: "plus";
                                size: IconSize.px64;
                                color: Cake.blue;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }

                    HeadingLg {
                        text: "Add a deterministic wallet";
                        horizontal-alignment: center;
                    }

                    TextMd {
                        text: "Prime can derive another Monero wallet from this device. Deterministic means the same Prime seed recreates the same wallet later.";
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    TextMd {
                        text: "If a Prime-derived wallet was removed, Create recreates the lowest missing wallet number. Each wallet has its own Cake pairing QR.";
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    CakeStatusBanner {
                        text: Callbacks.status-text;
                        danger: false;
                    }
                }

                ButtonSection {
                    CakeButton {
                        label: "Create wallet";
                        icon: "plus";
                        importance: Importance.primary;
                        clicked => {
                            if Callbacks.add-device-wallet-slot() {
                                Navigate.wallet-detail-page({ });
                            }
                        }
                    }
                }
            }
        }
    }
}
