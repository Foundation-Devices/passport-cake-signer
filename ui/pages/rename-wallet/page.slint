import { ButtonSection, ContentSection, HeadingLg, Input,
         PageBody, TextMd, BasePage } from "@ui/widgets.slint";
import { CakeButton, CakeNavHeader, CakeStatusBanner } from "../../cake-widgets.slint";
import { Importance, Size } from "@ui/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { RenameWalletPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Cake } from "../../cake-theme.slint";

export component RenameWalletPagePage inherits Rectangle {
    in property <RenameWalletPageProps> props;
    property <string> label-edit: Callbacks.wallet-rename-value;
    background: Cake.background;

    BasePage {
        background: Cake.background;

        VerticalLayout {
            CakeNavHeader {
                title: "Rename wallet";
                clicked => { Navigate.wallet-detail-page({ }); }
            }

            PageBody {
                ContentSection {
                    spacing: Size.sz4;

                    HeadingLg {
                        text: "Rename wallet";
                        horizontal-alignment: center;
                    }

                    TextMd {
                        text: "Choose a name that helps you recognize this wallet in Cake signing flows.";
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    Input {
                        text <=> label-edit;
                        placeholder: "Wallet name";
                        accept-button-text: "Save";
                        accepted(label) => {
                            if Callbacks.rename-active-wallet(label) {
                                Navigate.wallet-detail-page({ });
                            }
                        }
                    }

                    CakeStatusBanner {
                        text: Callbacks.status-text;
                        danger: false;
                    }
                }

                ButtonSection {
                    CakeButton {
                        label: "Save";
                        icon: "check";
                        importance: Importance.primary;
                        enabled: label-edit != "";
                        clicked => {
                            if Callbacks.rename-active-wallet(label-edit) {
                                Navigate.wallet-detail-page({ });
                            }
                        }
                    }
                }
            }
        }
    }
}
