import { ButtonSection, ContentSection, HeadingLg, Input,
         PageBody, TextLg, TextMd, TextSm, BasePage } from "@ui/widgets.slint";
import { CakeButton, CakeCard, CakeIcon, CakeNavHeader, CakeStatusBanner } from "../../cake-widgets.slint";
import { IconSize, Importance, Size } from "@ui/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { VerifyAddressPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Cake } from "../../cake-theme.slint";

component AddressBlockLine inherits Rectangle {
    in property <string> address;
    in property <int> row-index;
    private property <[string]> blocks: Callbacks.format-address-row(address, row-index);

    visible: blocks.length > 0;
    height: root.visible ? 36px : 0px;
    background: #00000000;

    HorizontalLayout {
        alignment: center;
        spacing: Size.sz2;

        for block[index] in blocks: TextSm {
            text: block;
            horizontal-stretch: 1;
            color: Math.mod(row-index * 6 + index, 2) == 0
                ? Cake.on-surface-strong
                : Cake.on-surface-soft;
            bold: Math.mod(row-index * 6 + index, 2) == 0;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: clip;
        }
    }
}

component VerifiedAddressCard inherits Rectangle {
    in property <string> detail;
    in property <string> address;

    height: 208px;
    border-radius: Size.sz3;
    background: Cake.surface-card-solid;
    clip: true;

    VerticalLayout {
        padding-left: Size.sz4;
        padding-right: Size.sz4;
        padding-top: Size.sz3;
        padding-bottom: Size.sz5;
        spacing: Size.sz1;

        TextSm {
            text: root.detail;
            color: Cake.on-surface-dim;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        AddressBlockLine { address: root.address; row-index: 0; }
        AddressBlockLine { address: root.address; row-index: 1; }
        AddressBlockLine { address: root.address; row-index: 2; }
        AddressBlockLine { address: root.address; row-index: 3; }
    }
}

export component VerifyAddressPagePage inherits Rectangle {
    in property <VerifyAddressPageProps> props;
    property <string> account: "0";
    property <string> subaddress: "0";
    background: Cake.background;

    function refresh-derived-address() {
        if (Callbacks.verify-ready && Callbacks.verify-title == "Derived address") {
            Callbacks.verify-address-index(account, subaddress);
        }
    }

    changed account => {
        refresh-derived-address();
    }

    changed subaddress => {
        refresh-derived-address();
    }

    init => {
        if (!Callbacks.verify-via-quantum-link) {
            Callbacks.clear-verify-address();
        }
    }

    BasePage {
        background: Cake.background;

        VerticalLayout {
            CakeNavHeader {
                title: "Verify address";
                clicked => {
                    Navigate.wallet-detail-page({ replace: Callbacks.verify-via-quantum-link });
                }
            }

            PageBody {
                p-y: Size.sz3;

                Rectangle {
                    height: 440px;
                    clip: true;

                    Flickable {
                        width: parent.width;
                        height: parent.height;

                        ContentSection {
                            width: parent.width;
                            spacing: Size.sz3;

                            if Callbacks.verify-via-quantum-link: VerticalLayout {
                                spacing: Size.sz3;

                                HorizontalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 72px;
                                        height: 72px;
                                        border-radius: self.width / 2;
                                        background: Callbacks.verify-matched
                                            ? Cake.success-bg
                                            : Cake.danger-bg;

                                        CakeIcon {
                                            name: Callbacks.verify-matched ? "check" : "alert";
                                            size: IconSize.px32;
                                            icon-color: Callbacks.verify-matched
                                                ? Cake.success
                                                : Cake.danger;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }

                                HeadingLg {
                                    text: Callbacks.verify-title;
                                    color: Callbacks.verify-matched ? Cake.success : Cake.danger;
                                    horizontal-alignment: center;
                                }

                                TextMd {
                                    text: Callbacks.verify-matched
                                        ? "Passport Prime independently derived the same address from this wallet's private keys."
                                        : "Passport Prime derived a different address. Do not use the address shown in Cake.";
                                    color: Cake.on-surface-dim;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                VerifiedAddressCard {
                                    detail: Callbacks.verify-detail;
                                    address: Callbacks.verify-address;
                                }
                            }

                            if !Callbacks.verify-via-quantum-link: VerticalLayout {
                                spacing: Size.sz3;

                                HeadingLg {
                                    text: "Check a Cake address";
                                    horizontal-alignment: center;
                                }

                                if !Callbacks.verify-ready: TextMd {
                                    text: "Scan a Cake address QR to confirm it belongs to this Prime wallet, or derive a known account/subaddress pair.";
                                    color: Cake.on-surface-dim;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                CakeCard {
                                    VerticalLayout {
                                        padding: Size.sz4;
                                        spacing: Size.sz3;
                                        TextSm {
                                            text: "Derive by index";
                                            color: Cake.on-surface-dim;
                                            horizontal-alignment: center;
                                        }
                                        HorizontalLayout {
                                            spacing: Size.sz2;
                                            Input {
                                                text <=> account;
                                                placeholder: "Account";
                                                input-type: InputType.number;
                                                show-clear-btn: false;
                                            }
                                            Input {
                                                text <=> subaddress;
                                                placeholder: "Subaddress";
                                                input-type: InputType.number;
                                                show-clear-btn: false;
                                            }
                                        }
                                    }
                                }

                                if Callbacks.verify-ready: VerticalLayout {
                                    spacing: Size.sz3;

                                    VerticalLayout {
                                        spacing: Size.sz3;
                                        TextLg {
                                            text: Callbacks.verify-title;
                                            color: Callbacks.verify-matched ? Cake.success : Cake.warning;
                                            bold: true;
                                            horizontal-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }

                                    if Callbacks.verify-address != "": VerifiedAddressCard {
                                        detail: Callbacks.verify-detail;
                                        address: Callbacks.verify-address;
                                    }
                                }
                            }

                            CakeStatusBanner {
                                text: Callbacks.status-text;
                                danger: !Callbacks.verify-matched;
                            }
                        }
                    }
                }

                ButtonSection {
                    if Callbacks.verify-via-quantum-link: CakeButton {
                        label: "Done";
                        importance: Importance.primary;
                        clicked => { Navigate.wallet-detail-page({ replace: true }); }
                    }
                    if !Callbacks.verify-via-quantum-link && (!Callbacks.verify-ready || Callbacks.verify-title != "Derived address"): CakeButton {
                        label: "Show derived address";
                        icon: "eye";
                        importance: Importance.normal;
                        clicked => { Callbacks.verify-address-index(account, subaddress); }
                    }
                    if !Callbacks.verify-via-quantum-link && Callbacks.verify-ready: CakeButton {
                        label: "Scan another";
                        icon: "scan-qr";
                        importance: Importance.normal;
                        clicked => { Callbacks.verify-address-scan(); }
                    }
                    if !Callbacks.verify-via-quantum-link && !Callbacks.verify-ready: CakeButton {
                        label: "Scan address QR";
                        icon: "scan-qr";
                        importance: Importance.primary;
                        clicked => { Callbacks.verify-address-scan(); }
                    }
                    if !Callbacks.verify-via-quantum-link && Callbacks.verify-ready: CakeButton {
                        label: "Done";
                        importance: Importance.primary;
                        clicked => { Navigate.wallet-detail-page({ }); }
                    }
                }
            }
        }
    }
}
