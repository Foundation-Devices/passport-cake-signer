import { ButtonSection, ContentSection, TextMd, BasePage, PageBody, DynamicQrCode } from "../../compat/widgets.slint";
import { CakeButton, CakeNavHeader, CakeStatusBanner } from "../../cake-widgets.slint";
import { Size, Importance } from "../../compat/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { SignedQrPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Cake } from "../../cake-theme.slint";

// Hand the signed transaction back to Cake as an ANIMATED UR QR
// (ur_type "xmr-txsigned"). Rust returns animated UR parts over the CBOR-wrapped
// wallet2 signed_tx_set.
export component SignedQrPagePage inherits Rectangle {
    in property <SignedQrPageProps> props;
    background: Cake.background;

    BasePage {
        background: Cake.background;

        VerticalLayout {
            CakeNavHeader {
                title: TR2.lookup(TrId.SignedQrTitle);
                left-icon: "chevron-left";
                clicked => { Navigate.home-page({ }); }
            }
            PageBody {
                ContentSection {
                    spacing: Size.sz4;
                    TextMd {
                        text: TR2.lookup(TrId.SignedQrSubtitle);
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: center;
                        DynamicQrCode {
                            get-parts(density) => {
                                Callbacks.get-signed-ur(density);
                            }
                        }
                    }
                    CakeStatusBanner {
                        text: Callbacks.status-text;
                        danger: false;
                    }
                }
                ButtonSection {
                    CakeButton {
                        label: "Save to file";
                        importance: Importance.normal;
                        enabled: Callbacks.signed-ok;
                        clicked => { Callbacks.save-signed-tx(); }
                    }
                    CakeButton {
                        label: TR2.lookup(TrId.Done);
                        importance: Importance.primary;
                        clicked => { Navigate.home-page({ }); }
                    }
                }
            }
        }
    }
}
