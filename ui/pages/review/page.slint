import { ButtonSection, ContentSection, HeadingMd, AppHeader, TextLg, TextMd, TextSm, BasePage, PageBody, Panel } from "@ui/widgets.slint";
import { CakeButton, CakeCard, CakeSlideToSign, CakeStatusBanner } from "../../cake-widgets.slint";
import { Palette, Size, Importance, UISize } from "@ui/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { ReviewPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Cake } from "../../cake-theme.slint";

// Verify exactly what the watch-only wallet asked us to sign BEFORE touching the
// spend key. Everything here is parsed from the unsigned_monero_tx on-device.
component Row inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <brush> value-color: Cake.on-surface;
    height: Size.sz10;

    HorizontalLayout {
        spacing: Size.sz3;
        padding-left: Size.sz4;
        padding-right: Size.sz4;

        TextMd {
            text: label;
            color: Cake.on-surface-dim;
            vertical-alignment: center;
            horizontal-stretch: 0;
            width: 124px;
            overflow: elide;
        }

        TextMd {
            text: value;
            color: value-color;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component AddressRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked;

    min-height: Size.sz15;
    border-radius: Size.sz3;
    background: Cake.surface-card;
    clip: true;

    VerticalLayout {
        padding-left: Size.sz4;
        padding-right: Size.sz4;
        padding-top: Size.sz3;
        padding-bottom: Size.sz3;
        spacing: Size.sz1;

        TextSm {
            text: label;
            color: Cake.on-surface-dim;
            overflow: elide;
        }

        TextMd {
            text: value;
            color: Cake.on-surface;
            wrap: word-wrap;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    states [
        pressed when touch.pressed: {
            root.background: Cake.surface-card-pressed;
        }
    ]
}

export component ReviewPagePage inherits Rectangle {
    in property <ReviewPageProps> props;
    property <bool> is-address-open: false;
    property <string> selected-dest-address: "";
    property <bool> observed-signed-ok: Callbacks.signed-ok;
    background: Cake.background;

    changed observed-signed-ok => {
        if (observed-signed-ok) {
            Navigate.signed-qr-page({ });
        }
    }

    BasePage {
        background: Cake.background;

        VerticalLayout {
            AppHeader { title: TR2.lookup(TrId.ReviewTitle); side-padding: Size.sz6; }
            PageBody {
                p-y: Size.sz3;

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    Flickable {
                        width: parent.width;
                        height: parent.height;

                        ContentSection {
                            width: parent.width;
                            spacing: Size.sz2;

                            Rectangle {
                                background: Cake.monero-card;
                                border-radius: Size.sz6;
                                height: 104px;
                                clip: true;
                                VerticalLayout {
                                    padding: Size.sz5;
                                    spacing: Size.sz2;
                                    TextMd { text: TR2.lookup(TrId.ReviewSending); color: Cake.on-monero; }
                                    TextLg {
                                        text: Callbacks.amount-xmr + " XMR";
                                        color: Cake.on-monero;
                                        bold: true;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            for recipient[index] in Callbacks.dest-address-labels: AddressRow {
                                label: index == 0 ? TR2.lookup(TrId.ReviewTo) : "Additional recipient";
                                value: recipient;
                                clicked => {
                                    selected-dest-address = Callbacks.dest-addresses[index];
                                    is-address-open = true;
                                }
                            }

                            CakeCard {
                                VerticalLayout {
                                    padding-top: Size.sz2;
                                    padding-bottom: Size.sz2;
                                    Row { label: TR2.lookup(TrId.ReviewChange);  value: Callbacks.change-xmr + " XMR"; }
                                    Row {
                                        label: TR2.lookup(TrId.ReviewFee);
                                        value: Callbacks.fee-xmr == "—" ? Callbacks.fee-xmr : Callbacks.fee-xmr + " XMR";
                                    }
                                    Row { label: TR2.lookup(TrId.ReviewOutputs); value: Callbacks.output-count; }
                                }
                            }

                            CakeCard {
                                VerticalLayout {
                                    padding: Size.sz4;
                                    spacing: Size.sz2;
                                    TextSm {
                                        text: TR2.lookup(TrId.ReviewFrom);
                                        color: Cake.on-surface-dim;
                                        overflow: elide;
                                    }
                                    TextMd {
                                        text: Callbacks.primary-address;
                                        color: Cake.on-surface;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                    }
                                    if Callbacks.tx-account-info != "": TextSm {
                                        text: Callbacks.tx-account-info;
                                        color: Cake.on-surface-dim;
                                        horizontal-alignment: right;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            CakeStatusBanner {
                                text: Callbacks.status-text;
                                danger: !Callbacks.tx-loading;
                            }
                        }
                    }
                }

                ButtonSection {
                    CakeButton {
                        label: TR2.lookup(TrId.Cancel);
                        importance: Importance.normal;
                        clicked => { Navigate.home-page({ }); }
                    }
                    if Callbacks.tx-loading: CakeButton {
                        label: "Reading transaction";
                        importance: Importance.primary;
                        enabled: false;
                        loading: true;
                    }
                    if !Callbacks.tx-loading && Callbacks.tx-loaded && Callbacks.status-text == "": CakeSlideToSign {
                        signing: Callbacks.signing;
                        activated => {
                            Callbacks.sign-transaction();
                        }
                    }
                    if !Callbacks.tx-loading && Callbacks.tx-loaded && Callbacks.status-text != "": CakeButton {
                        label: TR2.lookup(TrId.ReviewSign);
                        importance: Importance.primary;
                        clicked => {
                            Callbacks.sign-transaction();
                        }
                    }
                    if !Callbacks.tx-loading && !Callbacks.tx-loaded: CakeButton {
                        label: TR2.lookup(TrId.ReviewSign);
                        importance: Importance.primary;
                        enabled: false;
                    }
                }
            }
        }

        if is-address-open: Rectangle {
            z: 200;
            width: parent.width;
            height: parent.height;
            background: Palette.overlay;

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { is-address-open = false; }
            }

            Panel {
                width: UISize.modal-width;
                height: 300px;
                x: (parent.width - self.width) / 2;
                y: Size.sz16;
                background: Cake.surface;

                VerticalLayout {
                    padding: Size.sz6;
                    spacing: Size.sz4;

                    HeadingMd {
                        text: "Recipient address";
                        horizontal-alignment: center;
                    }
                    TextSm {
                        text: selected-dest-address;
                        color: Cake.on-surface;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Rectangle { }
                    CakeButton {
                        label: TR2.lookup(TrId.Done);
                        importance: Importance.primary;
                        clicked => { is-address-open = false; }
                    }
                }
            }
        }
    }
}
