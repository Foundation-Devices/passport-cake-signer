import { ButtonSection, ContentSection, HeadingMd, AppHeader, Button, Icon, TimerLoader, TextLg, TextMd, TextSm, BasePage, PageBody, Panel } from "@ui/widgets.slint";
import { CakeButton } from "../../cake-widgets.slint";
import { Palette, Size, Importance, UISize } from "@ui/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { ReviewPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Cake } from "../../cake-theme.slint";

// Verify exactly what the watch-only wallet asked us to sign BEFORE touching the
// spend key. Everything here is parsed from the unsigned_monero_tx on-device.
component Row inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <brush> value-color: Cake.on-surface;
    height: Size.sz8;

    HorizontalLayout {
        spacing: Size.sz2;

        TextMd {
            text: label;
            color: Cake.on-surface-dim;
            vertical-alignment: center;
            horizontal-stretch: 0;
            width: 112px;
        }

        TextMd {
            text: value;
            color: value-color;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component AddressRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked;

    height: Size.sz13;
    border-radius: Size.sz3;

    HorizontalLayout {
        spacing: Size.sz2;
        padding-left: Size.sz2;
        padding-right: Size.sz2;

        TextMd {
            text: label;
            color: Cake.on-surface-dim;
            vertical-alignment: center;
            horizontal-stretch: 0;
            width: Size.sz12;
        }
        TextMd {
            text: value;
            color: Cake.on-surface;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    states [
        pressed when touch.pressed: {
            root.background: Cake.surface-alt;
        }
    ]
}

component OrangeSlideToSign inherits Rectangle {
    in property <bool> signing: false;
    callback activated;

    border-radius: Size.sz6;
    height: Size.sz16 + (Size.sz1 * 2);
    background: Cake.surface-alt;

    private property <length> inner-width: self.width - Size.sz1 * 2;
    private property <length> inner-height: self.height - Size.sz1 * 2;
    private property <length> thumb-width: 112px;
    private property <length> max-slide-offset: max(Size.zero, inner-width - thumb-width);
    private property <length> drag-offset: touch.pressed ? touch.mouse-x - touch.pressed-x : 0px;
    private property <length> slide-offset: signing ? max-slide-offset : min(max-slide-offset, max(Size.zero, drag-offset));
    private property <bool> has-activated: false;

    changed signing => {
        if (!signing) {
            has-activated = false;
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: Size.sz2;

        if signing: TimerLoader {
            loader-color: Cake.monero;
            active-color: Cake.on-surface;
        }

        TextMd {
            text: signing ? "Signing" : TR2.lookup(TrId.ReviewSign);
            color: signing ? Cake.monero : Cake.on-surface-dim;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    target := Rectangle {
        x: parent.width - self.width - Size.sz1;
        y: Size.sz1;
        width: thumb-width;
        height: inner-height;
        border-radius: Size.sz6;
        background: Cake.surface;
        opacity: signing ? 0 : 1;
    }

    thumb := Rectangle {
        x: Size.sz1 + slide-offset;
        y: Size.sz1;
        width: thumb-width;
        height: inner-height;
        border-radius: Size.sz6;
        background: Cake.monero-card;
        opacity: signing ? 0 : 1;

        HorizontalLayout {
            alignment: center;
            spacing: Size.sz2;
            padding-left: Size.sz4;
            padding-right: Size.sz4;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Icon {
                    name: "arrow-right";
                    color: Cake.on-monero;
                    size: Size.sz5;
                }
            }

            TextMd {
                text: "Sign";
                color: Cake.on-monero;
                horizontal-stretch: 0;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        moved() => {
            if (!root.signing && !root.has-activated && root.slide-offset >= root.max-slide-offset) {
                root.has-activated = true;
                root.activated();
            }
        }
    }
}

export component ReviewPagePage inherits Rectangle {
    in property <ReviewPageProps> props;
    property <bool> is-address-open: false;
    property <string> selected-dest-address: "";
    property <bool> observed-signed-ok: Callbacks.signed-ok;
    background: Cake.background;

    changed observed-signed-ok => {
        if (observed-signed-ok) {
            Navigate.signed-qr-page({ });
        }
    }

    BasePage {
        background: Cake.background;

        VerticalLayout {
            AppHeader { title: TR2.lookup(TrId.ReviewTitle); side-padding: Size.sz6; }
            PageBody {
                ContentSection {
                    spacing: Size.sz3;

                    Rectangle {
                        background: Cake.monero-card;
                        border-radius: Size.sz3;
                        VerticalLayout {
                            padding: Size.sz5;
                            spacing: Size.sz2;
                            TextSm { text: TR2.lookup(TrId.ReviewSending); color: Cake.on-monero; }
                            TextLg { text: Callbacks.amount-xmr + " XMR"; color: Cake.on-monero; bold: true; }
                        }
                    }

                    for recipient[index] in Callbacks.dest-address-labels: AddressRow {
                        label: index == 0 ? TR2.lookup(TrId.ReviewTo) : "";
                        value: recipient;
                        clicked => {
                            selected-dest-address = Callbacks.dest-addresses[index];
                            is-address-open = true;
                        }
                    }
                    Row { label: TR2.lookup(TrId.ReviewChange);  value: Callbacks.change-xmr + " XMR"; }
                    Row {
                        label: TR2.lookup(TrId.ReviewFee);
                        value: Callbacks.fee-xmr == "—" ? Callbacks.fee-xmr : Callbacks.fee-xmr + " XMR";
                    }
                    Row { label: TR2.lookup(TrId.ReviewOutputs); value: Callbacks.output-count; }
                    Row { label: TR2.lookup(TrId.ReviewFrom);    value: Callbacks.primary-address; }

                    TextSm {
                        text: Callbacks.tx-account-info;
                        color: Cake.on-surface-dim;
                        horizontal-alignment: right;
                        wrap: word-wrap;
                    }

                    if Callbacks.status-text != "": TextSm {
                        text: Callbacks.status-text;
                        color: Cake.danger;
                        wrap: word-wrap;
                    }
                }

                ButtonSection {
                    CakeButton {
                        label: TR2.lookup(TrId.Cancel);
                        importance: Importance.normal;
                        clicked => { Navigate.home-page({ }); }
                    }
                    if Callbacks.tx-loaded && Callbacks.status-text == "": OrangeSlideToSign {
                        signing: Callbacks.signing;
                        activated => {
                            Callbacks.sign-transaction();
                        }
                    }
                    if Callbacks.tx-loaded && Callbacks.status-text != "": CakeButton {
                        label: TR2.lookup(TrId.ReviewSign);
                        importance: Importance.primary;
                        clicked => {
                            Callbacks.sign-transaction();
                        }
                    }
                    if !Callbacks.tx-loaded: CakeButton {
                        label: TR2.lookup(TrId.ReviewSign);
                        importance: Importance.primary;
                        enabled: false;
                    }
                }
            }
        }

        if is-address-open: Rectangle {
            z: 200;
            width: parent.width;
            height: parent.height;
            background: Palette.overlay;

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { is-address-open = false; }
            }

            Panel {
                width: UISize.modal-width;
                height: 300px;
                x: (parent.width - self.width) / 2;
                y: Size.sz16;
                background: Cake.surface;

                VerticalLayout {
                    padding: Size.sz6;
                    spacing: Size.sz4;

                    HeadingMd {
                        text: "Recipient address";
                        horizontal-alignment: center;
                    }
                    TextSm {
                        text: selected-dest-address;
                        color: Cake.on-surface;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Rectangle { }
                    CakeButton {
                        label: TR2.lookup(TrId.Done);
                        importance: Importance.primary;
                        clicked => { is-address-open = false; }
                    }
                }
            }
        }
    }
}
