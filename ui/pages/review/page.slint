import { ButtonSection, ContentSection, HeadingLg, AppHeader, Button, SlideToButton, TextLg, TextMd, TextSm, BasePage, PageBody } from "@ui/widgets.slint";
import { Palette, Size, Importance } from "@ui/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { ReviewPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Cake } from "../../cake-theme.slint";

// Verify exactly what the watch-only wallet asked us to sign BEFORE touching the
// spend key. Everything here is parsed from the unsigned_monero_tx on-device.
component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <brush> value-color: Cake.on-surface;
    spacing: Size.sz2;
    TextMd { text: label; color: Cake.on-surface-dim; }
    Rectangle { } // spacer
    TextMd { text: value; color: value-color; horizontal-alignment: right; }
}

export component ReviewPagePage inherits Rectangle {
    in property <ReviewPageProps> props;
    background: Cake.background;

    BasePage {
        background: Cake.background;

        VerticalLayout {
            AppHeader { title: TR2.lookup(TrId.ReviewTitle); side-padding: Size.sz6; }
            PageBody {
                ContentSection {
                    spacing: Size.sz3;

                    Rectangle {
                        background: Cake.monero-card;
                        border-radius: Size.sz3;
                        VerticalLayout {
                            padding: Size.sz5;
                            spacing: Size.sz2;
                            TextSm { text: TR2.lookup(TrId.ReviewSending); color: Cake.on-monero; }
                            TextLg { text: Callbacks.amount-xmr + " XMR"; color: Cake.on-monero; bold: true; }
                        }
                    }

                    Row { label: TR2.lookup(TrId.ReviewTo);      value: Callbacks.dest-address; }
                    Row { label: TR2.lookup(TrId.ReviewChange);  value: Callbacks.change-xmr + " XMR"; }
                    Row {
                        label: TR2.lookup(TrId.ReviewFee);
                        value: Callbacks.fee-xmr == "—" ? Callbacks.fee-xmr : Callbacks.fee-xmr + " XMR";
                    }
                    Row { label: TR2.lookup(TrId.ReviewOutputs); value: Callbacks.output-count; }
                    Row { label: TR2.lookup(TrId.ReviewFrom);    value: Callbacks.primary-address; }

                    if Callbacks.status-text != "": TextSm {
                        text: Callbacks.status-text;
                        color: Cake.danger;
                        wrap: word-wrap;
                    }
                }

                ButtonSection {
                    if Callbacks.tx-loaded && Callbacks.status-text == "": SlideToButton {
                        label: "Sign";
                        info-label: TR2.lookup(TrId.ReviewSign);
                        activated-label: "Signing";
                        icon: "arrow-right";
                        activated(id) => {
                            Callbacks.sign-transaction();
                            if Callbacks.signed-ok { Navigate.signed-qr-page({ }); }
                        }
                    }
                    if Callbacks.tx-loaded && Callbacks.status-text != "": Button {
                        label: TR2.lookup(TrId.ReviewSign);
                        importance: Importance.primary;
                        clicked => {
                            Callbacks.sign-transaction();
                            if Callbacks.signed-ok { Navigate.signed-qr-page({ }); }
                        }
                    }
                    if !Callbacks.tx-loaded: Button {
                        label: TR2.lookup(TrId.ReviewSign);
                        importance: Importance.primary;
                        enabled: false;
                    }
                    Button {
                        label: TR2.lookup(TrId.Cancel);
                        importance: Importance.normal;
                        clicked => { Navigate.home-page({ }); }
                    }
                }
            }
        }
    }
}
