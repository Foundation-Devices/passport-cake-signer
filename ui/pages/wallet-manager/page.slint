import { Icon, NavHeader, ScrollBody, TextLg, TextMd, TextSm, BasePage } from "@ui/widgets.slint";
import { Size, IconSize } from "@ui/theme.slint";
import { Callbacks, WalletRow } from "../../callbacks.slint";
import { WalletManagerPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Cake } from "../../cake-theme.slint";

component ArchivedWalletItem inherits Rectangle {
    in property <WalletRow> wallet;
    callback clicked;

    height: 78px;
    background: Cake.surface-alt;
    border-radius: Size.sz3;
    opacity: 0.72;
    clip: true;

    HorizontalLayout {
        padding-left: Size.sz4;
        padding-right: Size.sz4;
        spacing: Size.sz3;

        VerticalLayout {
            width: Size.sz11;
            alignment: center;
            Rectangle {
                width: Size.sz11;
                height: Size.sz11;
                border-radius: Size.sz6;
                background: Cake.surface;
                Icon {
                    name: "archive";
                    size: IconSize.px32;
                    color: Cake.on-surface-dim;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            TextLg {
                text: wallet.name;
                color: Cake.on-surface;
                bold: true;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    states [
        pressed when touch.pressed: {
            root.opacity: 0.82;
        }
    ]
}

export component WalletManagerPagePage inherits Rectangle {
    in property <WalletManagerPageProps> props;
    background: Cake.background;

    BasePage {
        background: Cake.background;

        VerticalLayout {
            NavHeader {
                title: "Archived wallets";
                clicked => { Navigate.home-page({ }); }
            }

            ScrollBody {
                p-x: Size.sz6;
                p-y: Size.sz4;

                VerticalLayout {
                    spacing: Size.sz4;

                    TextMd {
                        text: "Archived wallets are set aside. Open one to restore it or delete it permanently.";
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if Callbacks.archived-wallet-count == 0: TextSm {
                        text: "No archived wallets.";
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    for wallet in Callbacks.archived-wallets: ArchivedWalletItem {
                        wallet: wallet;
                        clicked => {
                            if Callbacks.select-wallet(wallet.id) {
                                Navigate.wallet-detail-page({ });
                            }
                        }
                    }

                    if Callbacks.status-text != "": TextSm {
                        text: Callbacks.status-text;
                        color: Cake.warning;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
