import { Button, ButtonSection, ContentSection, Icon, NavHeader,
         OverlayMenu, PageBody, PopupMenuItem, TextLg, TextMd, TextSm, BasePage } from "@ui/widgets.slint";
import { CakeButton } from "../../cake-widgets.slint";
import { Importance, Size, IconSize } from "@ui/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { WalletDetailPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Cake } from "../../cake-theme.slint";

component WalletHeroCard inherits Rectangle {
    in property <string> wallet-name;
    in property <bool> archived;
    in property <bool> derived;

    height: 250px;
    background: archived ? Cake.surface-alt : Cake.monero-card;
    border-radius: Size.sz6;
    clip: true;

    if !archived: Image {
        source: @image-url("../../../assets/icons/monero-card-inlay.svg");
        width: parent.width;
        height: parent.height;
    }

    VerticalLayout {
        padding: Size.sz5;
        spacing: Size.sz3;

        HorizontalLayout {
            spacing: Size.sz3;

            Rectangle {
                width: Size.sz12;
                height: Size.sz12;
                border-radius: Size.sz3;
                background: archived ? Cake.surface : #FFFFFF55;

                Icon {
                    name: archived ? "archive" : (derived ? "device" : "import");
                    size: IconSize.px32;
                    color: archived ? Cake.on-surface-dim : Cake.on-monero;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Rectangle { }
        }

        Rectangle { }

        TextSm {
            text: archived ? "Archived wallet" : (derived ? "Created on Prime" : "Imported wallet");
            color: archived ? Cake.on-surface-dim : Cake.on-monero;
            opacity: archived ? 1 : 0.72;
            overflow: elide;
        }

        TextLg {
            text: wallet-name;
            color: archived ? Cake.on-surface : Cake.on-monero;
            bold: true;
            wrap: word-wrap;
        }

        TextSm {
            text: derived ? "Recoverable from this device seed" : "Restored from a Monero seed";
            color: archived ? Cake.on-surface-dim : Cake.on-monero;
            opacity: archived ? 1 : 0.64;
            wrap: word-wrap;
        }
    }
}

export component WalletDetailPagePage inherits Rectangle {
    in property <WalletDetailPageProps> props;
    property <bool> is-menu-open: false;
    background: Cake.background;

    BasePage {
        background: Cake.background;

        VerticalLayout {
            NavHeader {
                title: "Wallet";
                right-icon: "ellipsis";
                clicked => { Navigate.home-page({ }); }
                right-clicked => { is-menu-open = !is-menu-open; }
            }

            PageBody {
                ContentSection {
                    spacing: Size.sz4;

                    WalletHeroCard {
                        wallet-name: Callbacks.wallet-label;
                        archived: Callbacks.wallet-archived;
                        derived: Callbacks.wallet-derived;
                    }

                    if Callbacks.wallet-archived: TextMd {
                        text: "This wallet is archived. Use the menu to restore or delete it.";
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if Callbacks.status-text != "": TextSm {
                        text: Callbacks.status-text;
                        color: Cake.warning;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                ButtonSection {
                    if !Callbacks.wallet-archived: CakeButton {
                        label: TR2.lookup(TrId.HomePairQr);
                        icon: "cake";
                        importance: Importance.normal;
                        clicked => {
                            Callbacks.prepare-pair-qr();
                            Navigate.pair-page({ });
                        }
                    }
                    if !Callbacks.wallet-archived: CakeButton {
                        label: "Verify address";
                        icon: "scan-qr";
                        importance: Importance.normal;
                        clicked => { Navigate.verify-address-page({ }); }
                    }
                    if !Callbacks.wallet-archived: CakeButton {
                        label: TR2.lookup(TrId.HomeSignTransaction);
                        icon: "scan-qr";
                        importance: Importance.primary;
                        clicked => {
                            Callbacks.scan-unsigned-tx();
                            if Callbacks.tx-loaded {
                                Navigate.review-page({ });
                            } else if Callbacks.keyimages-ready {
                                Navigate.keyimage-qr-page({ });
                            }
                        }
                    }
                }
            }
        }

        if is-menu-open: OverlayMenu {
            width: parent.width;
            height: parent.height;
            touched-off => { is-menu-open = false; }

            if !Callbacks.wallet-archived: PopupMenuItem {
                label: "Rename wallet";
                icon: "edit";
                first: true;
                clicked => {
                    is-menu-open = false;
                    Navigate.rename-wallet-page({ });
                }
            }
            if !Callbacks.wallet-archived: PopupMenuItem {
                label: TR2.lookup(TrId.MenuViewSeed);
                icon: "eye";
                last: !Callbacks.wallet-can-archive;
                clicked => {
                    is-menu-open = false;
                    Callbacks.prepare-seed-words();
                    Navigate.seed-page({ });
                }
            }
            if Callbacks.wallet-can-archive: PopupMenuItem {
                label: "Archive wallet";
                icon: "archive";
                last: true;
                clicked => {
                    is-menu-open = false;
                    Callbacks.archive-active-wallet();
                }
            }
            if Callbacks.wallet-can-restore: PopupMenuItem {
                label: "Restore wallet";
                icon: "archive";
                first: true;
                clicked => {
                    is-menu-open = false;
                    Callbacks.restore-active-wallet();
                }
            }
            if Callbacks.wallet-can-delete: PopupMenuItem {
                label: "Delete permanently";
                icon: "delete";
                last: true;
                clicked => {
                    is-menu-open = false;
                    Navigate.delete-wallet-confirm-page({ });
                }
            }
        }
    }
}
