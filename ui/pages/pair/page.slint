import { ButtonSection, ContentSection, TextMd, BasePage, PageBody, Qrcode } from "@ui/widgets.slint";
import { CakeButton, CakeNavHeader, CakeQrFrame } from "../../cake-widgets.slint";
import { Size, Importance } from "@ui/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { PairPageProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Cake } from "../../cake-theme.slint";

// One-time pairing. Prime shows a STATIC QR of the view-only credentials
// (primary address + private view key + restore height) as JSON. In Cake
// Wallet: Restore › Cupcake App scans it and builds the matching watch-only
// wallet. This is the exact payload CupCake emits (cake-tech/cupcake
// wallet.dart `pairQrString`).
export component PairPagePage inherits Rectangle {
    in property <PairPageProps> props;
    background: Cake.background;

    BasePage {
        background: Cake.background;

        VerticalLayout {
            CakeNavHeader {
                title: TR2.lookup(TrId.PairTitle);
                left-icon: "chevron-left";
                clicked => { Navigate.home-page({ }); }
            }
            PageBody {
                ContentSection {
                    spacing: Size.sz4;
                    TextMd {
                        text: TR2.lookup(TrId.PairSubtitle);
                        color: Cake.on-surface-dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: center;
                        CakeQrFrame {
                            Qrcode {
                                data: Callbacks.pair-json;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }
                }
                ButtonSection {
                    CakeButton {
                        label: TR2.lookup(TrId.Done);
                        importance: Importance.primary;
                        clicked => { Navigate.home-page({ }); }
                    }
                }
            }
        }
    }
}
