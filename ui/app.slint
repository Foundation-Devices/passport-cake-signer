import { Router } from "gen/router.slint";
import { Callbacks } from "callbacks.slint";
import { CurrentTheme, Images, Utils, Palettes, Theme, UISize } from "compat/theme.slint";
import { TR } from "compat/i18n.slint";
import { Cake } from "cake-theme.slint";

export component AppWindow inherits Window {
    title: "Cake Wallet Signer";
    preferred-width: UISize.screen-width;
    preferred-height: UISize.screen-height;
    background: Cake.background;

    init => {
        CurrentTheme.palette = Palettes.dark;
    }

    Router { }
}

export * from "gen/exports.slint";
export { Callbacks, CurrentTheme, Images, Utils, TR, Theme }
