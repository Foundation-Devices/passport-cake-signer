// Bridge between the Rust app (src/main.rs) and the Slint UI. The Rust side
// sets the properties and handles the callbacks; the pages read/invoke them.
export struct WalletRow {
    id: string,
    name: string,
    kind: string,
    address: string,
    detail: string,
    archived: bool,
    derived: bool,
    cake-linked: bool,
}

export global Callbacks {
    // --- One-time pairing -------------------------------------------------
    // Export this Passport's Monero view-only credentials (primary address +
    // private view key) to SD/USB so Cake Wallet mobile can create the
    // watch-only wallet that pairs with this signer.
    callback export-view-only();

    // Export current key images so the watch-only wallet knows which outputs
    // are already spent.
    callback export-key-images();

    // --- QR transport (CupCake-compatible) --------------------------------
    // Build the view-only pairing JSON and stash it in `pair-json` for the
    // pairing page's static QR. Cake "Restore › Cupcake App" scans it.
    callback prepare-pair-qr();
    // The pairing payload: {label, version, primaryAddress, privateViewKey,
    // restoreHeight} JSON, rendered as a single static QR.
    in-out property <string> pair-json;

    // --- QuantumLink transport --------------------------------------------
    // Device-level Passport Prime pairing data for Cake's hardware-wallet
    // flow. Cake scans ql-static-qr first to connect over BLE, then ql-identity-
    // parts to complete QuantumLink pairing.
    in-out property <string> ql-static-qr;
    in-out property <[string]> ql-identity-parts;
    in-out property <bool> ql-bt-connected;
    in-out property <bool> ql-paired;
    in-out property <bool> ql-live;
    // Device-level pairing with Cake, even when the live BLE session is down.
    in-out property <bool> ql-cake-paired;
    // True only when the live device-level peer is Cake Wallet. Do not use
    // ql-paired alone: it can refer to Envoy or a stale phone pairing.
    in-out property <bool> ql-cake-ready;
    in-out property <bool> ql-pairing-resetting;
    in-out property <string> ql-paired-device-name;
    in-out property <string> ql-status-text;
    callback begin-quantum-link-pairing();
    callback cancel-quantum-link-wallet-enrollment();
    callback unlink-active-wallet-from-cake() -> bool;
    callback disconnect-quantum-link();

    // Animated UR frames for the just-signed tx (ur_type "xmr-txsigned").
    // DynamicQrCode calls this with the max QR size; we return the parts model.
    // `pure` so it can be invoked from DynamicQrCode's pure get-parts callback.
    pure callback get-signed-ur(int) -> [string];

    // Scan an animated UR from Cake. If it's an "xmr-output" key-image sync,
    // builds the key images and sets keyimages-ready; if it's an "xmr-txunsigned"
    // tx, populates the review properties and sets tx-loaded.
    callback scan-unsigned-tx();
    // Set true after a key-image sync scan; the UI then shows the key-image QR.
    in-out property <bool> keyimages-ready;
    // Human-readable summary of the Cake output range Prime is returning.
    in-out property <string> keyimage-sync-detail;
    // Animated UR frames for the key images (ur_type "xmr-keyimage"). `pure` so
    // DynamicQrCode's get-parts can call it.
    pure callback get-keyimage-ur(int) -> [string];

    // Populate `seed-words` with the wallet's 16-word Polyseed recovery phrase
    // for the (gated) Show-seed screen. Secret material — shown only on demand.
    callback prepare-seed-words();
    callback clear-seed-words();
    in-out property <[string]> seed-words;
    in-out property <string> seed-qr-text;

    // --- Wallet identity --------------------------------------------------
    callback switch-next-wallet();
    callback select-wallet(string) -> bool;
    callback select-first-active-wallet() -> bool;
    callback add-device-wallet-slot() -> bool;
    callback import-seed-file() -> bool;
    callback import-seed-qr() -> bool;
    callback import-seed-text(string) -> bool;
    pure callback seed-import-preview(string) -> string;
    callback rename-active-wallet(string) -> bool;
    callback archive-active-wallet() -> bool;
    callback restore-active-wallet() -> bool;
    callback delete-active-wallet() -> bool;
    callback clear-verify-address();
    callback verify-address-scan();
    callback verify-address-index(string, string) -> bool;
    in-out property <string> wallet-id;
    in-out property <string> wallet-label;
    in-out property <string> wallet-kind;
    in-out property <string> wallet-address;
    in-out property <string> wallet-address-full;
    in-out property <string> wallet-detail;
    in-out property <string> wallet-rename-value;
    in-out property <[string]> wallet-list;
    in-out property <[WalletRow]> wallets;
    in-out property <[WalletRow]> archived-wallets;
    in-out property <bool> wallet-derived;
    // Wallet-scoped Cake association. QuantumLink itself is paired at the
    // device level, so UI must combine this with ql-paired.
    in-out property <bool> wallet-cake-linked;
    in-out property <int> wallet-count;
    in-out property <int> archived-wallet-count;
    in-out property <bool> wallet-archived;
    in-out property <bool> wallet-can-archive;
    in-out property <bool> wallet-can-restore;
    in-out property <bool> wallet-can-delete;
    in-out property <bool> verify-ready;
    in-out property <bool> verify-matched;
    in-out property <string> verify-title;
    in-out property <string> verify-detail;
    in-out property <string> verify-address;
    in-out property <bool> verify-via-quantum-link;

    // --- Signing flow -----------------------------------------------------
    // Import an unsigned_monero_tx file (built by the Cake mobile watch-only
    // wallet) from a file picker. Populates the review properties below.
    callback import-unsigned-tx();

    // Sign the loaded unsigned tx with the app-seed spend key and cache the
    // signed_monero_tx for QR display. Saving to file is explicit.
    callback sign-transaction();
    callback cancel-transaction-review();
    callback finish-transaction-review();

    // Split a Monero address into one row of four 4-character blocks for the
    // review UI. The Rust implementation keeps address formatting byte-safe
    // and reusable for both source and destination addresses.
    pure callback format-address-row(string, int) -> [string];

    // Write the cached signed_monero_tx through the file picker.
    callback save-signed-tx();

    // --- Review properties (set by Rust after import) ---------------------
    in-out property <string> primary-address;       // full source wallet address
    in-out property <string> amount-xmr;            // real amount sent (excl change), formatted
    in-out property <string> change-xmr;            // change returned to this wallet, formatted
    in-out property <string> fee-xmr;               // network fee, formatted ("—" until computed)
    in-out property <string> dest-address;          // recipient, truncated
    in-out property <[string]> dest-addresses;      // full recipient addresses
    in-out property <[string]> dest-address-labels; // recipient amount + truncated address
    in-out property <string> tx-account-info;       // Cake account/subaddress metadata
    in-out property <int>    output-count;
    in-out property <bool>   tx-loading;            // true while the unsigned tx parser is working
    in-out property <bool>   tx-loaded;             // gate the Sign button
    in-out property <bool>   signed-ok;             // true only if signing actually succeeded
    in-out property <bool>   signing;               // true while the signer thread is working
    in-out property <bool>   tx-via-quantum-link;   // response returns directly to Cake over QL
    in-out property <string> status-text;           // error / progress line
}
