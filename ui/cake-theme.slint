// Cake Wallet inspired dark palette, tuned toward Cake's navy shell, soft blue
// controls, and Monero-orange account card while staying coherent with KeyOS.
export global Cake {
    // Cake brand blue (primary CTA / accents) and variants.
    out property <brush> blue: #91AAFF;          // Cake dark CTA blue from the mobile app
    out property <brush> blue-dim: #6F88DB;       // pressed / muted CTA
    out property <brush> blue-deep: #19274D;      // deep accent

    // Monero accent (this is a Monero wallet app).
    out property <brush> monero: #F35A24;         // Monero orange card/accent
    out property <brush> monero-card: #F35A24;    // Monero card surface

    // Surfaces (Cake dark theme).
    out property <brush> background: #17213C;      // app shell navy
    out property <brush> surface: #243258;         // primary card
    out property <brush> surface-alt: #2C3B68;     // raised card
    out property <brush> divider: #384A78;         // divider

    // Status.
    out property <brush> success: #58F332;         // brightGreen — signed / done
    out property <brush> warning: #F3A632;         // orangeYellow — caution
    out property <brush> danger:  #C30000;         // red — error / reject

    // Content.
    out property <brush> on-blue: #FFFFFF;         // text on the blue fill
    out property <brush> on-surface: #EFF3FF;
    out property <brush> on-surface-dim: #A9B5E8;  // muted label text
    out property <brush> on-monero: #1A1A1A;
}
